{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mxuanvan02/academic-prose/schemas/glossary-entry.schema.json",
  "title": "Bilingual academic glossary entry",
  "type": "object",
  "required": [
    "source",
    "preferred",
    "domain",
    "definition",
    "status",
    "policy"
  ],
  "properties": {
    "source": {
      "type": "string",
      "minLength": 1
    },
    "preferred": {
      "type": "string",
      "minLength": 1
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "avoid": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "context_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "deprecated",
        "needs_review"
      ]
    },
    "policy": {
      "description": "Localization decision for this concept; see references/terminology-localization.md",
      "enum": [
        "keep_source",
        "translate",
        "translate_with_gloss",
        "keep_with_gloss",
        "needs_review"
      ]
    },
    "authority_tier": {
      "description": "1 legal/national standard, 2 textbook/approved dictionary, 3 attested journal usage, 4 official international version, 5 writer's morphological inference",
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "authority_note": {
      "type": "string"
    },
    "gloss_at_first_use": {
      "type": "boolean"
    },
    "paired_term": {
      "description": "Exact term used for this concept in the other language version",
      "type": "string"
    },
    "distinguished_from": {
      "description": "Concepts that must not share this rendering, e.g. reliability for an entry on validity",
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
