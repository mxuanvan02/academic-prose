{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mxuanvan02/academic-prose/schemas/audit-record.schema.json",
  "title": "Language-parameterized academic audit record",
  "type": "object",
  "required": ["segment_id", "source_language", "target_language", "source_text", "draft_text", "revised_text", "error_types", "severity", "rationale", "semantic_change", "confidence", "decision"],
  "properties": {
    "segment_id": {"type": "string", "minLength": 1},
    "source_language": {"enum": ["vi", "en"]},
    "target_language": {"enum": ["vi", "en"]},
    "source_text": {"type": "string"},
    "draft_text": {"type": "string"},
    "revised_text": {"type": "string"},
    "error_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "severity": {"enum": ["block", "major", "minor", "none"]},
    "rationale": {"type": "string", "minLength": 1},
    "semantic_change": {"type": "boolean"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "register_verdict": {"description": "Resolution of an internal-register finding. 'soften' is not available: hedging an internal sentence leaves it internal. See references/internal-register-gate.md", "enum": ["delete", "recast", "relocate", "license", "not_applicable"]},
    "decision": {"enum": ["accept", "revise", "human_review"]}
  },
  "additionalProperties": false
}
